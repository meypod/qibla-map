# Supply-chain hardening. See https://pnpm.io/settings

# Refuse any version published less than 3 days ago. Worms like Shai-Hulud
# spread through freshly published versions and are normally yanked well inside
# that window, so a compromised release never gets resolved here. Exempt a
# single package with minimum-release-age-exclude if a hotfix is ever urgent.
minimum-release-age=4320

# Dependency lifecycle scripts are how those worms execute. pnpm 10 blocks them
# by default; this keeps that non-overridable. Each package that ships one is
# reviewed and recorded under pnpm.allowBuilds in package.json.
dangerously-allow-all-builds=false

# Fail the install when a dependency introduces a build script that is not in
# that list, rather than printing a warning that scrolls past. This is the
# tripwire: a package that suddenly grows a postinstall stops the build.
strict-dep-builds=true

# Fail scripts when node_modules drifts from the lockfile instead of silently
# running against whatever happens to be on disk.
verify-deps-before-run=error

# Resolve from the lockfile; do not quietly pick up newer versions.
prefer-frozen-lockfile=true
